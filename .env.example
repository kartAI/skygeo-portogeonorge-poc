# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# Used by `portolan push` / `portolan sync` when no destination is passed explicitly.
PORTOLAN_REMOTE=https://kartais...

AZURE_STORAGE_ACCOUNT=kartai...
AZURE_STORAGE_SAS_TOKEN="sp=rac...."

# Destination path (blob prefix) inside the AZURE_STORAGE_ACCOUNT container used by
# `az storage blob upload-batch` to publish catalog/ — see README.technical.md.
AZURE_DESTINATION_PATH=dok2portolan-poc
